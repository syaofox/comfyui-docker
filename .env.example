# ComfyUI Docker 环境变量配置

# 用户 UID/GID（与宿主机一致，避免权限问题）
PUID=1000
PGID=1000

# GitHub 加速代理前缀（留空则直连）
# 中国大陆推荐: https://ghfast.top
GH_PROXY=https://ghfast.top

# apt 包镜像地址（留空则使用官方源）
# 中国大陆推荐: https://mirrors.aliyun.com
APT_MIRROR=https://mirrors.ustc.edu.cn

# PyPI 镜像地址（留空则使用官方源）
# 中国大陆推荐: https://pypi.tuna.tsinghua.edu.cn/simple
PIP_MIRROR=https://pypi.mirrors.ustc.edu.cn/simple

# HuggingFace 镜像端点（留空则直连）
# 中国大陆推荐: https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com

# ComfyUI 更新模式（tag=最新 Release 标签 / latest=默认分支最新提交）
COMFYUI_UPDATE_MODE=latest

# 第二块硬盘的模型根目录（宿主机绝对路径），需含 checkpoints/loras/gguf 等类别子目录
# 留空则不挂载额外路径；以只读方式合并进 ComfyUI（见 extra_model_paths.yaml）
EXTRA_MODELS_PATH=

# 跳过自定义节点依赖安装（1/true/yes=跳过，0=按 hash 智能安装，默认 0）
SKIP_CUSTOM_NODE_REQUIREMENTS=0
# 强制每次都重装节点依赖（调试用，1=忽略 hash，默认 0）
FORCE_CUSTOM_NODE_REQUIREMENTS=0

# ComfyUI 额外启动参数（拼接到 python3 main.py --listen 之后，多个用空格分隔）
# 16G 内存 + 12G 显存推荐：--disable-pinned-memory --fp16-intermediates
#   --disable-pinned-memory  避免 pinned 内存上限被 swap 顶高，减少内存压力
#   --fp16-intermediates     中间张量 fp16，省内存/显存（实验性，可能有画质问题）
#   --cache-none             最省内存但每次重算，最慢，仅内存仍不足时使用
#   --fast-disk             优先磁盘后备 offload，需 NVMe 且磁盘有充足余量
COMFYUI_ARGS=
